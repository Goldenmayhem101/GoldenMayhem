<resources>
    <color name="bg">#07090C</color>

    <!-- Launch screen: the Breach Run icon on the game's night background (Android's splash screen) -->
    <style name="Theme.BreachRun.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">#141C28</item>
        <item name="postSplashScreenTheme">@style/Theme.BreachRun</item>
    </style>

    <style name="Theme.BreachRun" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
