# Copy these into your host's environment settings. Never commit a real key.
GEMINI_API_KEY=
RATE_LIMIT_PER_HOUR=10
# ACCESS_CODE=choose-a-code
# Speed and accuracy:
# GEMINI_MODEL=gemini-3.8-flash      # tried first; the default is a faster "flash-lite" model
# PARALLEL=4                         # pieces of a long video transcribed at the same time
# CHUNK_SECONDS=360                  # target length of each piece
# CHUNK_ABOVE_SECONDS=420            # only videos longer than this are split
